# Historical 50 kV comparison only; the literature diffuse case is 20 kV.
/run/numberOfThreads 32
/random/setSeeds 1357911 2468022
/rosworm/mmPerUnit 0.1
/rosworm/maxStep_um 2 um
/rosworm/saveSteps true
/rosworm/sourceType diffuse
/rosworm/spectrumType kramers
/rosworm/kvp 50 keV
/rosworm/minEnergy 1 keV
/rosworm/sourceY -2.0 mm
/rosworm/halfX 0.6 mm
/rosworm/halfZ 0.6 mm
/run/initialize
/tracking/verbose 0
/run/printProgress 10000
/run/beamOn 1000000
