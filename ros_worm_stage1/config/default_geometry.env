# Validated full worm geometry: voxel-remeshed OpenWorm-derived core + nervous system.
# Source this file from any working directory. The transport executable also
# uses these files as its compiled defaults.
_ROSWORM_CONFIG_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd)"
export ROSWORM_MANIFEST="${_ROSWORM_CONFIG_DIR}/transport_geometry_v1.csv"
export ROSWORM_MATERIALS="${_ROSWORM_CONFIG_DIR}/region_materials.csv"
unset _ROSWORM_CONFIG_DIR
export ROSWORM_MM_PER_UNIT=0.1
